# ─────────────────────────────────────────────────────────────
# Hospital Management System — Environment Variables
# Copy this file to .env.development / .env.production and fill in values
# 

# Server
NODE_ENV=development
PORT=3000

# MongoDB
DATABASE_URL=mongodb://localhost:27017/hospital_db
 
# JWT secrets — use long random strings in production
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# CORS — comma-separated list of allowed frontend origins
# Use * to allow all (development only)
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5173

# Cookie settings
COOKIE_SECURE=false          # set true in production (requires HTTPS)
COOKIE_DOMAIN=               # e.g. .yourdomain.com in production

# Hospital identity & branding
# SYSTEM=pagia               # uncomment if deploying for Pagia system
HOSPITAL_NAME=My Hospital
HOSPITAL_VISIT_PREFIX=OPD
HOSPITAL_DAYCARE_PREFIX=DC
HOSPITAL_IPD_PREFIX=IPD
HOSPITAL_LOGO_PATH=          # absolute path to logo file (optional, uses default if blank)
HOSPITAL_LOGO_EXT=png        # png or jpeg

# AWS S3 — used for Aadhaar card, patient images, X-ray uploads
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_BUCKET_NAME=hospital-uploads
S3_SIGNED_URL_EXPIRES=3600   # seconds

# WHO ICD-11 API — for ICD diagnosis code search
# Register at: https://icdaccessmanagement.who.int
ICD_CLIENT_ID=your_icd_client_id
ICD_CLIENT_SECRET=your_icd_client_secret

# SMS (KYI SMS gateway)
KYI_SMS_API_KEY=your_sms_api_key
KYI_SMS_API_URL=https://sms-gateway-url.com/api/send
KYI_SMS_SENDER_ID=HOSP

# WhatsApp (Meta Cloud API)
WHATSAPP_MESSAGING=true      # set false to disable WhatsApp notifications
phoneNumberId=your_whatsapp_phone_number_id
accessToken=your_whatsapp_access_token

# Pagia WhatsApp (only needed if SYSTEM=pagia)
PAGIA_WHATSAPP_API_KEY=your_pagia_whatsapp_api_key
