{
  "name": "pathbyte-backend",
  "version": "1.0.0",
  "description": "To make it easy for you to get started with GitLab, here's a list of recommended next steps.",
  "main": "index.js",
  "scripts": {
    "copy-assets": "copyfiles -u 1 \"src/libs/templates/**/*\" dist/",
    "build": "rimraf dist && tsc -p tsconfig.json && npm run copy-assets",
    "prestart": "npm run build",
    "start": "node dist/server",
    "serve": "concurrently \"tsc -p tsconfig.json -w\" \"nodemon\" ",
    "lint": "eslint .",
    "test": "jest --runInBand",
    "create-hospital-admin": "node scripts/create-hospital-admin.js",
    "create-pathlab-admin": "node scripts/create-pathlab-admin.js",
    "add-dashboard-indexes": "node scripts/add-dashboard-indexes.js",
    "restore-dump": "node scripts/restore-from-dump.js"
  },
  "repository": {
    "type": "git",
    "url": "git@gitlab.user_kilobyte:pathbyte/pathbyte-backend.git"
  },
  "keywords": [],
  "author": "Deepak Singh <negid0253@gmail.com>",
  "license": "ISC",
