{
  "type": "object",
  "properties": {
    "patientId": {
      "type": "string",
      "minLength": 24,
      "maxLength": 24,
      "description": "MongoDB _id of the hospital patient"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "YYYY-MM-DD — defaults to today IST if omitted"
    }
  },
  "required": ["patientId"],
  "additionalProperties": false
}
