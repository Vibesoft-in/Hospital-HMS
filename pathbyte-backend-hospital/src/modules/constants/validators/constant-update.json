{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "key": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Z_][A-Z0-9_]*$"
    },
    "value": {},
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "isActive": {
      "type": "boolean"
    }
  }
}
