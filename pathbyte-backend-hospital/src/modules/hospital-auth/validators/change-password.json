{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "currentPassword": {
      "type": "string",
      "minLength": 8,
      "description": "Current password"
    },
    "newPassword": {
      "type": "string",
      "minLength": 8,
      "description": "New password (minimum 8 characters)"
    }
  },
  "required": ["currentPassword", "newPassword"],
  "additionalProperties": false
}
