{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "username": {
      "type": "string",
      "minLength": 3,
      "maxLength": 50,
      "description": "Username (optional, auto-generated from email if not provided)"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "User email address"
    },
    "password": {
      "type": "string",
      "minLength": 8,
      "description": "User password (minimum 8 characters)"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "User full name"
    },
    "phoneNumber": {
      "type": "string",
      "description": "User phone number (optional)"
    },
    "role": {
      "type": "string",
      "enum": ["ADMIN", "RECEPTIONIST", "RECEPTIONIST2", "DOCTOR", "DIALYSIS", "PHARMACIST", "ACCOUNTANT", "XRAY", "ABDM_ADMIN"],
      "description": "User role"
    },
    "linkedDoctorId": {
      "type": "string",
      "minLength": 24,
      "maxLength": 24,
      "description": "MongoDB _id of the linked HospitalDoctor (required when role is DOCTOR)"
    }
  },
  "required": ["email", "password", "name", "role"],
  "additionalProperties": false
}
