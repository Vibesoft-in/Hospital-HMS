{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["patientId"],
  "properties": {
    "patientId":    { "type": "string", "minLength": 1 },
    "procedureId":  { "type": "string" },
    "date":         { "type": "string", "description": "YYYY-MM-DD — defaults to today in IST" },
    "reportHtml":   { "type": "string" },
    "docUrl":       { "type": "string", "description": "S3 key returned by the upload API" },
    "isUltrasound": { "type": "boolean" }
  }
}
