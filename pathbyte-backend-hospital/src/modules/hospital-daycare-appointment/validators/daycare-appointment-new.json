{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["patientId", "doctorVisitCharges"],
  "properties": {
    "patientId": {
      "type": "string",
      "minLength": 1,
      "description": "MongoDB _id of the patient"
    },
    "doctorId": {
      "type": "string",
      "minLength": 1,
      "description": "Optional MongoDB _id of the consulting doctor"
    },
    "daycareChargesType": {
      "type": "string",
      "enum": ["Private", "Semi-Private", "General", "Custom", "None"],
      "description": "Type of daycare charges (optional)"
    },
    "daycareChargesHours": {
      "type": "number",
      "minimum": 0,
      "description": "Number of hours (optional)"
    },
    "customDaycareRate": {
      "type": "number",
      "minimum": 1,
      "description": "Custom rate per hour (required when daycareChargesType is 'Custom')"
    },
    "procedureIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Array of procedure MongoDB _ids"
    },
    "doctorVisitCharges": {
      "type": "boolean",
      "description": "Whether to include doctor visit charges"
    },
    "discount": {
      "type": "number",
      "minimum": 0,
      "description": "Discount amount"
    },
    "discountPassword": {
      "type": "string",
      "description": "Password for discount authorization"
    },
    "appointmentDate": {
      "type": "string",
      "format": "date",
      "description": "Appointment date in YYYY-MM-DD format (optional, defaults to today)"
    }
  },
  "additionalProperties": false
}
