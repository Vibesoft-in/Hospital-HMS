{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["doctorVisitCharges"],
  "properties": {
    "daycareChargesType": {
      "type": "string",
      "enum": ["Private", "Semi-Private", "General", "Custom", "None"],
      "description": "Type of daycare charges (optional)"
    },
    "daycareChargesHours": {
      "type": "number",
      "minimum": 0,
      "description": "Number of hours (optional)"
    },
    "customDaycareRate": {
      "type": "number",
      "minimum": 1,
      "description": "Custom rate per hour (required when daycareChargesType is 'Custom')"
    },
    "procedureIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Array of procedure MongoDB _ids"
    },
    "doctorId": {
      "type": "string",
      "minLength": 1,
      "description": "MongoDB _id of the consulting doctor (required if doctorVisitCharges is true)"
    },
    "doctorVisitCharges": {
      "type": "boolean",
      "description": "Whether to include doctor visit charges"
    }
  },
  "additionalProperties": false
}
